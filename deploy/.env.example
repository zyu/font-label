# 复制为 deploy/.env 后修改：cp .env.example .env && chmod 600 .env
# 生成随机密钥：openssl rand -base64 32

POSTGRES_PASSWORD=change-me-strong-db-password

# JWT 与图片签名密钥：必须改，且两个不能相同
JWT_SECRET=change-me-64-chars-random
MEDIA_SIGN_SECRET=change-me-another-64-chars-random

# 首次启动创建的管理员（登录后会强制改密）
ADMIN_INIT_PASSWORD=change-me-admin-initial

# 对外访问地址（导出文件名、文档里引用）
PUBLIC_BASE_URL=http://localhost:8088

# 端口（宿主机）
WEB_PORT=8088

# 数据库镜像：默认 postgres:16-alpine；若本地只有 postgres:16，脚本会自动复用
# POSTGRES_IMAGE=postgres:16
